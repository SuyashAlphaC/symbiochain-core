# Local paper operation. Never paste real keys into a public repository.
NODE_ENV=development
EXECUTION_MODE=PAPER
DATABASE_URL=postgresql://symbio:symbio_local@localhost:55439/symbiochain
# Optional separate migration URL; use Supabase session mode (5432) or direct IPv6, not 6543.
DIRECT_DATABASE_URL=
DATABASE_POOL_MAX=10

# Optional local deployment-management keys; do not forward these to the app runtime.
RENDER_API_KEY=
CRON_JOB_API_KEY=
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
ADMIN_TOKEN=local-demo-admin-token-change-before-hosting-0001
READ_TOKEN=local-demo-read-token-change-before-hosting-00001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Generate for live use: openssl rand -hex 32
EVIDENCE_ENCRYPTION_KEY=9c2f2503f551fb28a6f481b520f2520b1ab0340f5a0117c566cdd674c68b76e8
BASE_ASSET=USDC
BASE_DECIMALS=6
MAX_TRADE_ATOMS=10000000
MAX_DAILY_SPEND_ATOMS=50000000
MIN_RESERVE_ATOMS=2000000
MIN_NET_PROFIT_ATOMS=10000
MAX_SLIPPAGE_BPS=50
ALLOWED_ASSETS=USDC,WNEAR
ALLOWED_CHAINS=near:paper,eip155:31337
ALLOWED_RECIPIENTS=paper.treasury
WORKER_POLL_MS=500
WORKER_LEASE_MS=60000
SCOUT_INTERVAL_MS=10000
# LIVE requires the real adapters and separately funded dedicated accounts.
LIVE_TRADING_ENABLED=false
